# Copy values into your process environment; this script does not load .env files.
REPORT_API_URL=https://idontlivealone.onrender.com
# Leave BOTH values empty for app pairing (recommended). No user number needed.
REPORT_USER_NO=
REPORT_API_TOKEN=
DEVICE_NAME=PC AI Report
# Optional: absolute private directory outside Git; default reporting/device_state.
DEVICE_STATE_DIR=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
REPORT_DAILY_TIME=23:50
# Optional: absolute local directory outside Git.
REPORT_OUTBOX_DIR=
