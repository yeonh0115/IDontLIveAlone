<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1E293B"
                android:endColor="#090D16"
                android:angle="0" />
        </shape>
    </item>

    <item android:top="0dp" android:bottom="290dp">
        <shape android:shape="rectangle">
            <solid android:color="#334155"/>
        </shape>
    </item>
    <item android:top="290dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B"/>
        </shape>
    </item>

    <item android:left="20dp" android:right="20dp" android:top="40dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#475569" />
        </shape>
    </item>

    <item android:right="-4dp" android:top="-4dp" android:bottom="-4dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#3182F6" />
        </shape>
    </item>

</layer-list>