<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    card_view:cardBackgroundColor="#FFFFFF"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="0dp"
    card_view:cardMaxElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3182F6"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#4E5968"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3" />

        <!-- 📌 [추가] 리스트 항목 내에서 캡처된 이미지를 보여줄 그릇 -->
        <!-- 이미지가 없을 때는 영역을 차지하지 않도록 visibility를 gone으로 둡니다. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_image_container"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            card_view:cardCornerRadius="8dp"
            card_view:cardElevation="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_captured_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#F4F7FC" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.cardview.widget.CardView>