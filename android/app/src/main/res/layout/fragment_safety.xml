<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="본인 확인을 진행해 주세요"
            android:textColor="#191F28"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_current_pw"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text"
            android:backgroundTint="#F2F4F6"
            android:hint="현재 계정 비밀번호"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#191F28"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:drawable/btn_default"
            android:backgroundTint="#3182F6"
            android:text="인증하기"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_new_pw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="#E5E8EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="새로운 도어락 번호"
                android:textColor="#191F28"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_new_door_pw"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F2F4F6"
                android:hint="신규 번호 입력"
                android:inputType="numberPassword"
                android:paddingHorizontal="16dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_confirm_door_pw"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F2F4F6"
                android:hint="신규 번호 재확인"
                android:inputType="numberPassword"
                android:paddingHorizontal="16dp"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#3182F6"
                android:text="변경 완료"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>